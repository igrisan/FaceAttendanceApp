<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FaceAttendanceApp.SeedTestDataPage"
             Title="Dev: Seed Test Data">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Scale/Accuracy Test Seeder"
                   FontSize="20"
                   FontAttributes="Bold" />

            <Label x:Name="StatusLabel"
                   Text="Loading..."
                   FontSize="14" />

            <BoxView HeightRequest="1" Color="LightGray" />

            <Label Text="1) Random synthetic workers (speed/scale test)"
                   FontAttributes="Bold" />
            <Label Text="Random embeddings only test DB load and matching speed, not accuracy."
                   FontSize="12"
                   TextColor="Gray" />
            <Entry x:Name="RandomCountEntry"
                   Placeholder="Count (e.g. 9950)"
                   Keyboard="Numeric" />
            <Button x:Name="SeedRandomBtn"
                    Text="Seed Random Workers"
                    Clicked="OnSeedRandomClicked" />

            <BoxView HeightRequest="1" Color="LightGray" />

            <Label Text="2) Real faces from a folder (accuracy test)"
                   FontAttributes="Bold" />
            <Label Text="Path to a folder of face images (e.g. an LFW subset), one face per image."
                   FontSize="12"
                   TextColor="Gray" />
            <Entry x:Name="RealFacesFolderEntry"
                   Placeholder="/storage/emulated/0/.../lfw_subset" />
            <Button x:Name="SeedRealFacesBtn"
                    Text="Import Real Faces"
                    Clicked="OnSeedRealFacesClicked" />

            <BoxView HeightRequest="1" Color="LightGray" />

            <Label Text="3) Cleanup"
                   FontAttributes="Bold" />
            <Button x:Name="ClearTestDataBtn"
                    Text="Clear All Seeded Test Data"
                    BackgroundColor="OrangeRed"
                    TextColor="White"
                    Clicked="OnClearTestDataClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
